<%- include('../partials/head', { titulo: 'Ingresar' }) %>

<section class="tarjeta estrecha">
  <p class="etiqueta">Acceso a tu cuenta</p>
  <h1>Ingresa a tu cuenta</h1>
  <form method="post" action="/ingresar" class="formulario" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Correo electrónico
      <input type="email" name="email" required autocomplete="email" value="<%= valores.email || '' %>">
    </label>
    <label>Contraseña
      <input type="password" name="password" required autocomplete="current-password">
    </label>
    <button class="boton" type="submit">Ingresar</button>
  </form>
  <p class="tenue"><a href="/recuperar">¿Olvidaste tu contraseña?</a></p>
  <p class="tenue"><a href="/verificacion/reenvio">¿Necesitas verificar tu correo?</a></p>
  <p class="tenue">¿No tienes cuenta? <a href="/registro">Crea una</a></p>
</section>

<%- include('../partials/foot') %>
