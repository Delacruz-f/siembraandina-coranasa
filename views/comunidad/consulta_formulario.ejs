<%- include('../partials/head') %>

<section class="tarjeta estrecha">
  <h1>Consultar a un técnico</h1>
  <p class="tenue">La consulta se compartirá con técnicos que atienden el distrito seleccionado.</p>
  <% if (consultaPublica) { %>
    <aside class="tarjeta" aria-labelledby="consulta-publica-adjunta-titulo">
      <h2 id="consulta-publica-adjunta-titulo"><%= t("consultaPublica.adjuntaTitulo") %></h2>
      <p><%= t("consultaPublica.adjuntaTexto") %></p>
      <ul>
        <% (consultaPublica.ventanas_sugeridas || []).forEach((ventana) => { %>
          <li>
            <strong><%= ventana.nombre %></strong>:
            <%= new Date(`${ventana.inicio}T00:00:00Z`).toLocaleDateString("es-PE", { timeZone: "UTC" }) %> –
            <%= new Date(`${ventana.fin}T00:00:00Z`).toLocaleDateString("es-PE", { timeZone: "UTC" }) %>
            (<%= Math.round(ventana.puntaje) %> %)
            <% if (ventana.cosecha) { %>
              <br><%= t("consultaPublica.cosecha") %>:
              <%= new Date(`${ventana.cosecha.inicio}T00:00:00Z`).toLocaleDateString("es-PE", { timeZone: "UTC" }) %> –
              <%= new Date(`${ventana.cosecha.fin}T00:00:00Z`).toLocaleDateString("es-PE", { timeZone: "UTC" }) %>
              <% if (ventana.cosecha.referencial) { %>
                (<%= t("consultaPublica.referencial") %>)
              <% } %>
            <% } %>
          </li>
        <% }) %>
      </ul>
    </aside>
  <% } %>
  <form id="form-consulta" method="post" action="/panel/consultas" enctype="multipart/form-data" class="formulario">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Título
      <input name="titulo" required minlength="5" maxlength="180" placeholder="Ej.: Hojas de papa amarillas">
    </label>
    <label>Descripción
      <textarea name="contenido" rows="6" required minlength="10" maxlength="5000" placeholder="Describe cuándo comenzó, qué observaste y las condiciones recientes."></textarea>
    </label>
    <label>Cultivo (opcional)
      <select name="cultivo_id">
        <option value="">Elige un cultivo</option>
        <% cultivos.forEach((cultivo) => { %>
          <option value="<%= cultivo.id %>"><%= cultivo.nombre %></option>
        <% }) %>
      </select>
    </label>
    <fieldset class="formulario">
      <legend>Ubicación del cultivo</legend>
      <label>Departamento
        <select id="consulta-departamento" required>
          <option value="">Elige un departamento</option>
          <% departamentos.forEach((departamento) => { %>
            <option value="<%= departamento.id %>"><%= departamento.nombre %></option>
          <% }) %>
        </select>
      </label>
      <label>Provincia
        <select id="consulta-provincia" required>
          <option value="">Elige una provincia</option>
          <% provincias.forEach((provincia) => { %>
            <option value="<%= provincia.id %>" data-departamento-id="<%= provincia.departamento_id %>"><%= provincia.nombre %></option>
          <% }) %>
        </select>
      </label>
      <label>Distrito
        <select id="consulta-distrito" name="distrito_id" required>
          <option value="">Elige un distrito</option>
        </select>
      </label>
    </fieldset>
    <label>Fotos del cultivo (hasta 3; JPG, PNG o WEBP, máximo 10 MB cada una)
      <input id="fotos-consulta" type="file" name="fotos" accept="image/jpeg,image/png,image/webp" multiple>
    </label>
    <div id="alternativos-consulta" class="formulario"></div>
    <p id="estado-consulta" role="status" aria-live="polite"></p>
    <button class="boton" type="submit">Enviar consulta</button>
  </form>
</section>
<script src="/js/consultas.js" defer></script>

<%- include('../partials/foot') %>
