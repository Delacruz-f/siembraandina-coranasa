<%- include('../partials/head', { titulo: 'Panel técnico' }) %>

<section class="panel-hero">
  <div>
    <p class="panel-hero__saludo">Acompañamiento técnico</p>
    <h1>Panel técnico</h1>
    <p>
      Valida los requerimientos y el calendario tradicional, y revisa las parcelas que los agricultores te asignaron.
    </p>
  </div>
  <div class="panel-hero__acciones">
    <a class="boton" href="/tecnico/avisos">Publicar avisos por zona</a>
  </div>
</section>

<section class="rejilla-metricas" aria-label="Indicadores del panel técnico">
  <article class="metrica metrica--azul">
    <span class="metrica__icono" aria-hidden="true"><%- include('../iconos/mapa') %></span>
    <span class="metrica__valor"><%= parcelas.length %></span>
    <span class="metrica__etiqueta">Parcelas asignadas</span>
    <span class="metrica__pie">Con acceso concedido</span>
  </article>
  <article class="metrica metrica--morado">
    <span class="metrica__icono" aria-hidden="true"><%- include('../iconos/escudo') %></span>
    <span class="metrica__valor"><%= historialAccesos.length %></span>
    <span class="metrica__etiqueta">Permisos registrados</span>
    <span class="metrica__pie">Historial de accesos</span>
  </article>
  <article class="metrica metrica--verde">
    <span class="metrica__icono" aria-hidden="true"><%- include('../iconos/gota') %></span>
    <span class="metrica__valor"><%= requerimientos.length %></span>
    <span class="metrica__etiqueta">Requerimientos</span>
    <span class="metrica__pie">Cultivo y zona</span>
  </article>
  <article class="metrica metrica--naranja">
    <span class="metrica__icono" aria-hidden="true"><%- include('../iconos/libro') %></span>
    <span class="metrica__valor"><%= calendario.length %></span>
    <span class="metrica__etiqueta">Ventanas de siembra</span>
    <span class="metrica__pie">Calendario tradicional</span>
  </article>
</section>

<section class="tarjeta">
  <h2>Parcelas asignadas</h2>
  <% if (!parcelas.length) { %>
  <p class="tenue">Ningún agricultor te ha concedido acceso todavía.</p>
  <% } else { %>
  <div class="tabla-scroll">
    <table>
      <thead>
        <tr>
          <th>Parcela</th>
          <th>Agricultor</th>
          <th>Cultivo</th>
          <th>Zona</th>
          <th>Permiso</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% parcelas.forEach(function (p) { %>
        <tr>
          <td><%= p.nombre %></td>
          <td><%= p.dueno_nombre %></td>
          <td><%= p.cultivo %></td>
          <td><%= p.zona_nombre %></td>
          <td><%= p.puede_escribir ? 'Lectura y escritura' : 'Solo lectura' %></td>
          <td><a href="/tecnico/parcelas/<%= p.id %>">Ver</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<section class="tarjeta">
  <h2>Historial de permisos de parcela</h2>
  <% if (!historialAccesos.length) { %>
  <p class="tenue">Aún no tienes accesos concedidos.</p>
  <% } else { %>
  <div class="tabla-scroll">
    <table>
      <thead>
        <tr>
          <th>Parcela</th>
          <th>Agricultor</th>
          <th>Distrito</th>
          <th>Permiso</th>
          <th>Concedido</th>
          <th>Vigencia</th>
        </tr>
      </thead>
      <tbody>
        <% historialAccesos.forEach((acceso) => { %>
        <tr>
          <td><%= acceso.parcela %></td>
          <td><%= acceso.agricultor %></td>
          <td><%= acceso.distrito || '—' %></td>
          <td><%= acceso.puede_escribir ? 'Lectura y escritura' : 'Solo lectura' %></td>
          <td><%= fechaHora(acceso.concedido_en) %></td>
          <td><%= acceso.revocado_en ? `Revocado ${fechaHora(acceso.revocado_en)}` : 'Vigente' %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<section class="tarjeta">
  <h2>Requerimientos por cultivo y zona</h2>
  <p class="tenue">
    Humedad en % volumétrico aproximado y temperatura del suelo en °C. Al guardar, el registro queda marcado como
    validado por ti.
  </p>
  <div class="tabla-scroll">
    <table>
      <thead>
        <tr>
          <th>Cultivo</th>
          <th>Zona</th>
          <th>Humedad mín.</th>
          <th>Humedad máx.</th>
          <th>Temp. mín.</th>
          <th>Temp. máx.</th>
          <th>Estado</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% requerimientos.forEach(function (r) { %>
        <tr>
          <form
            method="post"
            action="/tecnico/requerimientos/<%= r.id %>"
            data-confirmar="¿Guardar y validar estos requerimientos agronómicos?"
          >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <td><%= r.cultivo %></td>
            <td><%= r.zona_nombre %></td>
            <td>
              <input
                class="campo-numero"
                type="number"
                step="0.1"
                min="0"
                max="100"
                name="humedad_min"
                value="<%= Number(r.humedad_min) %>"
                required
              />
            </td>
            <td>
              <input
                class="campo-numero"
                type="number"
                step="0.1"
                min="0"
                max="100"
                name="humedad_max"
                value="<%= Number(r.humedad_max) %>"
                required
              />
            </td>
            <td>
              <input
                class="campo-numero"
                type="number"
                step="0.1"
                min="-30"
                max="60"
                name="temperatura_min"
                value="<%= Number(r.temperatura_min) %>"
                required
              />
            </td>
            <td>
              <input
                class="campo-numero"
                type="number"
                step="0.1"
                min="-30"
                max="60"
                name="temperatura_max"
                value="<%= Number(r.temperatura_max) %>"
                required
              />
            </td>
            <td>
              <% if (r.validado) { %>
              <span class="insignia insignia-ok">Validado</span>
              <br /><span class="tenue"><%= r.validador || '' %> · <%= fecha(r.validado_en) %></span>
              <% } else { %>
              <span class="insignia insignia-aviso">Referencial</span>
              <% } %>
            </td>
            <td><button class="boton boton-pequeno" type="submit">Validar</button></td>
          </form>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<section class="tarjeta">
  <h2>Calendario tradicional de siembra</h2>
  <p class="tenue">Meses del 1 (enero) al 12 (diciembre).</p>
  <div class="tabla-scroll">
    <table>
      <thead>
        <tr>
          <th>Cultivo</th>
          <th>Zona</th>
          <th>Mes inicio</th>
          <th>Mes fin</th>
          <th>Estado</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% calendario.forEach(function (c) { %>
        <tr>
          <form
            method="post"
            action="/tecnico/calendario/<%= c.id %>"
            data-confirmar="¿Guardar y validar esta ventana tradicional?"
          >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <td><%= c.cultivo %></td>
            <td><%= c.zona_nombre %></td>
            <td>
              <input
                class="campo-numero"
                type="number"
                min="1"
                max="12"
                name="mes_inicio"
                value="<%= c.mes_inicio %>"
                required
              />
            </td>
            <td>
              <input
                class="campo-numero"
                type="number"
                min="1"
                max="12"
                name="mes_fin"
                value="<%= c.mes_fin %>"
                required
              />
            </td>
            <td>
              <% if (c.validado) { %>
              <span class="insignia insignia-ok">Validado</span>
              <br /><span class="tenue"><%= c.validador || '' %> · <%= fecha(c.validado_en) %></span>
              <% } else { %>
              <span class="insignia insignia-aviso">Referencial</span>
              <% } %>
            </td>
            <td><button class="boton boton-pequeno" type="submit">Validar</button></td>
          </form>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../partials/foot') %>
