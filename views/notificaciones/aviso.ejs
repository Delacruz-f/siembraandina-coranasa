<%- include('../partials/head') %>
<article class="tarjeta">
  <p class="etiqueta"><%= aviso.tipo %> · <%= aviso.distrito %></p>
  <h1><%= aviso.titulo %></h1>
  <p><%= aviso.mensaje %></p>
  <p class="tenue">Publicado: <%= fechaHora(aviso.vigente_desde) %><% if (aviso.vigente_hasta) { %> · Vigente hasta: <%= fechaHora(aviso.vigente_hasta) %><% } %></p>
  <a class="boton boton-secundario" href="/notificaciones">Volver a notificaciones</a>
</article>
<%- include('../partials/foot') %>
