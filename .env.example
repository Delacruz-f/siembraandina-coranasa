# Entorno: development | test | production
NODE_ENV=development

# ---------- Servidor ----------
PORT=3000
# 1 si está detrás de Nginx/Apache (lee la IP real y HTTPS). En producción: 1
TRUST_PROXY=0

# ---------- Base de datos ----------
# Motor: mysql2 (MySQL 8 / MariaDB de XAMPP) o pg (PostgreSQL 15)
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=siembra_andina
# Tiempo máximo de espera al conectar (ms)
DB_CONNECT_TIMEOUT_MS=5000
# Tiempo máximo de espera a NASA POWER (ms)
NASA_TIMEOUT_MS=8000
# Tiempo máximo de espera al pronóstico Open-Meteo (ms)
OPEN_METEO_TIMEOUT_MS=8000
# Reintentos para errores de red, timeout y HTTP 5xx/429
EXTERNAL_API_RETRIES=2
# Tiempo de caché para consultas por coordenada (ms; 6 horas)
WEATHER_CACHE_TTL_MS=21600000
# IA opcional para estimar rangos de cultivos fuera de la base y redactar
# el calendario público. Sin clave, se usa una plantilla fija y el resultado
# queda como de baja confianza. La clave NUNCA se envía al navegador.
# IA_PROVEEDOR: anthropic | gemini (o vacío)
IA_PROVEEDOR=
IA_API_KEY=
# Si se deja vacío se usa el modelo por defecto del proveedor.
IA_MODELO=
IA_TIMEOUT_MS=8000

# ---------- Calendario público (volátil, sin base de datos) ----------
# Caché en memoria de los resultados por coordenada redondeada (6 horas).
CALENDARIO_CACHE_TTL_MS=21600000
CALENDARIO_CACHE_MAX=500
# Geocodificación de lugares con Open-Meteo (sin clave), solo Perú.
GEOCODIFICACION_URL=https://geocoding-api.open-meteo.com/v1/search
GEOCODIFICACION_CACHE_TTL_MS=86400000
# Límite de peticiones por IP a los endpoints nuevos.
GEOCODIFICAR_RATE_LIMIT_WINDOW_MS=60000
GEOCODIFICAR_RATE_LIMIT_MAX=20
CALENDARIO_RATE_LIMIT_WINDOW_MS=900000
CALENDARIO_RATE_LIMIT_MAX=30
# Opcional, reservado para el adaptador SMAP (NASA Earthdata Login)
EARTHDATA_USER=
EARTHDATA_TOKEN=
AGROMONITORING_API_KEY=
# ---------- Administrador inicial (opcional; npm run seed) ----------
# Si completas una variable, completa las tres. La contraseña debe tener
# entre 12 y 72 caracteres. El seed guarda únicamente su hash bcrypt.
ADMIN_EMAIL=
ADMIN_NOMBRE=
ADMIN_PASSWORD=

# Para PostgreSQL cambia solo estas líneas:
# DB_CLIENT=pg
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=tu_clave

# ---------- Sesión ----------
# Obligatorio, mínimo 32 caracteres. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio-de-32-o-mas
SESSION_COOKIE_NAME=siembra.sid
# Duración de la sesión en milisegundos (7 días)
SESSION_MAX_AGE_MS=604800000
# 1 solo si el sitio se sirve por HTTPS (obligatorio en producción)
SESSION_COOKIE_SECURE=0

# ---------- Correo saliente (SMTP) ----------
# APP_BASE_URL debe ser la URL pública usada en los enlaces de verificación.
APP_BASE_URL=http://localhost:3000
# MAIL_MODE: smtp (envío real) | consola (solo desarrollo: imprime enlaces en terminal, no envía)
MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
# true para TLS implícito (normalmente puerto 465); false para STARTTLS (587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Siembra Andina <no-reply@example.com>
EMAIL_VERIFICATION_HOURS=24

# ---------- Logs ----------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ---------- Límite de peticiones ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_LOCK_MINUTES=15
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5

# ---------- Subidas de imágenes ----------
# Carpeta de binarios (documentos, imágenes). DEBE estar fuera de public/.
UPLOADS_DIR=storage/uploads
# Tamaño máximo por archivo en bytes (10 MB: admite fotos de celular).
UPLOADS_MAX_BYTES=10485760

# ---------- Imágenes (Fase 10) ----------
# Adaptador de almacenamiento: local | s3 | cloudinary
STORAGE_DRIVER=local
# Calidad de las variantes generadas con sharp (WebP y respaldo JPG)
IMAGE_WEBP_QUALITY=78
IMAGE_JPG_QUALITY=80
# Horas de espera antes de considerar huérfana una imagen sin asociar
IMAGE_ORPHAN_HOURS=24
# Solo si STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
# Solo si STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_URL_BASE=

# ---------- Producción y Docker (Fase 12) ----------
# Copia este archivo como .env y completa los valores antes de
# `docker compose up --build`. Ver docs/despliegue.md.
#
# Puerto público del contenedor en la máquina anfitriona
PUERTO_PUBLICO=3000
# 1 si está detrás de Nginx/Traefik (obligatorio en un VPS con HTTPS)
TRUST_PROXY=1
# 1 obligatorio cuando el sitio se sirve por HTTPS (producción real)
SESSION_COOKIE_SECURE=0
# Migraciones y catálogos al arrancar el contenedor
MIGRATE_ON_START=true
# SEED_ON_START solo la primera vez: no sobrescribe, pero tarda en arrancar
SEED_ON_START=false
# Respaldos: cada cuántas horas y cuántos días se conservan
RESPALDO_HORAS=24
RESPALDO_RETENCION_DIAS=14

# ---------- Internacionalización (Fase 12) ----------
# Idioma por defecto: es | qu | en
IDIOMA_POR_DEFECTO=es
# Idiomas disponibles, separados por coma
IDIOMAS_DISPONIBLES=es,qu,en

# ---------- API v1 (Fase 12) ----------
# Activa /api/v1 y la documentación en /api/docs
API_V1_ACTIVA=true

# Publica datos de demostración en /siembras cuando hay pocos datos reales.
# Siempre aparecen identificados como demostración. Usa false para ocultarlos.
SIEMBRAS_DEMO_PUBLICAS=true
