<%- include('../partials/head', { titulo: 'Recuperar contraseña' }) %>

<section class="tarjeta estrecha">
  <p class="etiqueta">Recuperación segura</p>
  <h1>Recupera tu contraseña</h1>
  <p class="tenue">Te enviaremos un enlace de un solo uso, válido durante una hora.</p>
  <form method="post" action="/recuperar" class="formulario">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Correo electrónico
      <input type="email" name="email" required autocomplete="email" value="<%= valores.email || '' %>">
    </label>
    <button class="boton" type="submit">Enviar instrucciones</button>
  </form>
  <p class="tenue"><a href="/ingresar">Volver a ingresar</a></p>
</section>

<%- include('../partials/foot') %>
